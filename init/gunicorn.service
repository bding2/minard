[Unit]
Description=Gunicorn instance to serve Minard
After=network.target

[Service]
User=gunicorn
Group=gunicorn
WorkingDirectory=/home/snotdaq/SNOPLUS/minard
Environment="MINARD_SETTINGS=/etc/minard/settings.cfg"
ExecStart=/opt/minard/bin/gunicorn -w 4 --error-logfile /var/log/gunicorn.log minard:app
Restart=always

[Install]
WantedBy=multi-user.target