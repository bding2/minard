[Unit]
Description=Gunicorn instance to serve Snoplus Log
After=network.target

[Service]
User=snotdaq
Group=snotdaq
WorkingDirectory=/home/snotdaq/SNOPLUS/minard
Environment="MINARD_SETTINGS=/etc/minard/settings.cfg"
ExecStart=/opt/minard/bin/gunicorn -w 4 -b 0.0.0.0:8081 snoplus_log:app --error-logfile=/var/log/gunicorn_snoplus_log.log --pid=/var/run/gunicorn_snoplus_log.pid
Restart=always

[Install]
WantedBy=multi-user.target